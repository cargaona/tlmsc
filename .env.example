# Required: Telegram Bot Configuration
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: Path Configuration
# Defaults are fine for most setups
STAGING_PATH=/data/staging
MUSIC_LIBRARY_PATH=/data/music

# Optional: Debug Mode
DEBUG=false

# ========================================
# Streamrip Credentials (Required for search/download)
# ========================================

# Qobuz Credentials
# Sign up at https://www.qobuz.com (requires Premium subscription)
# QOBUZ_PASSWORD should be the MD5 hash or auth token (not plaintext)
# Get this from: rip config --qobuz (or use existing from config.toml)
# Leave empty to disable Qobuz
QOBUZ_EMAIL=your_qobuz_email@example.com
QOBUZ_PASSWORD=your_md5_hash_or_auth_token

# Deezer Credentials
# Get your ARL token from browser cookies:
# 1. Visit https://www.deezer.com and login
# 2. Open DevTools (F12)
# 3. Go to Application → Cookies
# 4. Find cookie named "arl" and copy its value
# Leave empty to disable Deezer
DEEZER_ARL=your_arl_token_from_browser_cookies

# ========================================
# Note: You need at least ONE service configured
# The bot will try both Qobuz and Deezer
# ========================================
